@echo off
rem CinePulse Installer v2 - self-contained process environment.
rem Intentionally no SETLOCAL: callers inherit these variables.
for %%I in ("%~dp0..") do set "CINEPULSE_ROOT=%%~fI"
set "CINEPULSE_DATA_DIR=%CINEPULSE_ROOT%\data"
set "CINEPULSE_COMPONENTS_DIR=%CINEPULSE_ROOT%\components"
set "CINEPULSE_CACHE_DIR=%CINEPULSE_ROOT%\cache"
set "CINEPULSE_TEMP_DIR=%CINEPULSE_ROOT%\temp"
set "TEMP=%CINEPULSE_TEMP_DIR%"
set "TMP=%CINEPULSE_TEMP_DIR%"
set "TMPDIR=%CINEPULSE_TEMP_DIR%"
set "UV_CACHE_DIR=%CINEPULSE_CACHE_DIR%\uv"
set "UV_PYTHON_INSTALL_DIR=%CINEPULSE_ROOT%\.runtime\pythons"
set "PIP_CACHE_DIR=%CINEPULSE_CACHE_DIR%\pip"
set "TORCH_HOME=%CINEPULSE_CACHE_DIR%\torch"
set "XDG_CACHE_HOME=%CINEPULSE_CACHE_DIR%\xdg"
set "HF_HOME=%CINEPULSE_CACHE_DIR%\huggingface"
set "NUMBA_CACHE_DIR=%CINEPULSE_CACHE_DIR%\numba"
set "MPLCONFIGDIR=%CINEPULSE_CACHE_DIR%\matplotlib"
set "PYTHONPYCACHEPREFIX=%CINEPULSE_CACHE_DIR%\pycache"
set "PYTHONNOUSERSITE=1"
set "PIP_DISABLE_PIP_VERSION_CHECK=1"
set "PYTHONUTF8=1"
set "CUDA_DEVICE_ORDER=PCI_BUS_ID"
set "CUDA_VISIBLE_DEVICES=0"
set "CINEPULSE_PREFER_DEDICATED_GPU=1"

for %%D in (
  "%CINEPULSE_DATA_DIR%"
  "%CINEPULSE_DATA_DIR%\logs"
  "%CINEPULSE_COMPONENTS_DIR%"
  "%CINEPULSE_CACHE_DIR%"
  "%CINEPULSE_CACHE_DIR%\uv"
  "%CINEPULSE_CACHE_DIR%\pip"
  "%CINEPULSE_CACHE_DIR%\torch"
  "%CINEPULSE_CACHE_DIR%\huggingface"
  "%CINEPULSE_CACHE_DIR%\numba"
  "%CINEPULSE_CACHE_DIR%\matplotlib"
  "%CINEPULSE_CACHE_DIR%\pycache"
  "%CINEPULSE_TEMP_DIR%"
  "%CINEPULSE_ROOT%\.runtime"
) do if not exist "%%~D" mkdir "%%~D" >nul 2>&1
