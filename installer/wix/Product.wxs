<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Id="CinePulse.Studio"
    Name="CinePulse"
    Manufacturer="CinePulse Project"
    Version="$(var.ProductVersion)"
    Language="1046"
    Scope="perUser"
    UpgradeCode="5E804E94-E00A-47DF-A22A-85AF39D46586">
    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais recente do CinePulse instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="CinePulseIcon" SourceFile="!(bindpath.Payload)\assets\cinepulse.ico" />
    <Property Id="ARPPRODUCTICON" Value="CinePulseIcon" />

    <!-- Installer v2 uses the standard InstallDir wizard so the user explicitly
         chooses the root that will own code, Python, AI runtimes, data, cache
         and temp. The default remains per-user/writable and needs no admin. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="installer\wix\license.rtf" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CinePulse" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CinePulseMenuFolder" Name="CinePulse">
        <Component Id="StartMenuShortcut" Guid="D4053345-EA93-4DAE-B272-AF3B3E31D2D5">
          <Shortcut Id="CinePulseStartMenuShortcut" Name="CinePulse" Description="Estúdio local de vídeo e visuais musicais"
                    Target="[INSTALLFOLDER]CinePulse-Installed.cmd" WorkingDirectory="INSTALLFOLDER" Icon="CinePulseIcon" />
          <RemoveFolder Id="RemoveCinePulseMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\CinePulse" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="12D2C630-8E04-4A32-AD1B-B49D592A6F4B">
        <Shortcut Id="CinePulseDesktopShortcut" Name="CinePulse" Description="Estúdio local de vídeo e visuais musicais"
                  Target="[INSTALLFOLDER]CinePulse-Installed.cmd" WorkingDirectory="INSTALLFOLDER" Icon="CinePulseIcon" />
        <RegistryValue Root="HKCU" Key="Software\CinePulse" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="CinePulse" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\.cinepulse-portable" />
      </Files>
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <CustomAction Id="LaunchCompleteSetup" Directory="INSTALLFOLDER"
      ExeCommand="&quot;[SystemFolder]cmd.exe&quot; /D /C start &quot;&quot; &quot;[INSTALLFOLDER]Install-CinePulse-Installed.cmd&quot;"
      Execute="immediate" Impersonate="yes" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchCompleteSetup" After="InstallFinalize" Condition="NOT Installed AND ACTION &lt;&gt; &quot;ADMIN&quot; AND CINEPULSE_SKIP_BOOTSTRAP &lt;&gt; &quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
