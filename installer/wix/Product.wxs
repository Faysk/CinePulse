<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Id="CinePulse.Studio"
    Name="CinePulse"
    Manufacturer="CinePulse Project"
    Version="1.0.0"
    Language="1046"
    Scope="perUser"
    UpgradeCode="5E804E94-E00A-47DF-A22A-85AF39D46586">
    <MajorUpgrade DowngradeErrorMessage="Já existe uma versão mais recente do CinePulse instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="CinePulse" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="CinePulseMenuFolder" Name="CinePulse">
        <Component Id="StartMenuShortcut" Guid="D4053345-EA93-4DAE-B272-AF3B3E31D2D5">
          <Shortcut
            Id="CinePulseStartMenuShortcut"
            Name="CinePulse"
            Description="Estúdio local de vídeo e visuais musicais"
            Target="[INSTALLFOLDER]CinePulse.cmd"
            WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveCinePulseMenuFolder" On="uninstall" />
          <RegistryValue
            Root="HKCU"
            Key="Software\CinePulse"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="CinePulse" Level="1">
      <Files Directory="INSTALLFOLDER" Include="!(bindpath.Payload)\**">
        <Exclude Files="!(bindpath.Payload)\.cinepulse-portable" />
      </Files>
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <CustomAction
      Id="LaunchCompleteSetup"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]installer\Start-CinePulse.ps1&quot; -InstallOnly"
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="LaunchCompleteSetup" After="InstallFinalize" Condition="NOT Installed AND ACTION &lt;&gt; &quot;ADMIN&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
